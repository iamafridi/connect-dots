{
  "name": "connectdots",
  "version": "1.0.0",
  "description": "ConnectDots — a production-grade URL shortener engineered on Node.js to absorb 800k+ requests per second and 40M+ requests per month. Built entirely from scratch by Afridi Akbar Ifty.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx ./src/index.ts",
    "cluster:dev": "node --env-file-if-exists=.env --import tsx ./src/cluster.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p . && node -e \"require('fs').cpSync('src/lib/email/templates','dist/lib/email/templates',{recursive:true})\"",
    "typecheck": "tsc -p .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "start": "node --env-file-if-exists=.env ./dist/index.js",
    "cluster:prod": "node --env-file-if-exists=.env ./dist/cluster.js",
    "janitor": "node --env-file-if-exists=.env --import tsx ./src/janitor.ts",
    "prod": "pm2 start ecosystem.config.cjs",
    "schema": "node --env-file-if-exists=.env --import tsx ./src/database/schema-cli.ts",
    "seed": "node --env-file-if-exists=.env --import tsx ./src/database/seed.ts",
    "perf:seed": "node --env-file-if-exists=.env --import tsx ./src/perf/seed.ts",
    "perf:migrate": "node --env-file-if-exists=.env --import tsx ./src/perf/migrate.ts",
    "perf:sync": "node --env-file-if-exists=.env --import tsx ./src/perf/sync.ts",
    "test": "cross-env DB_DATABASE=connectdots_test NODE_ENV=test SKIP_EMAIL=true REDIS=false mocha"
  },
  "keywords": [
    "url-shortener",
    "nodejs",
    "high-performance",
    "redis",
    "postgresql",
    "cpeak"
  ],
  "author": {
    "name": "Afridi Akbar Ifty",
    "url": "https://iamafrididev.netlify.app"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1042.0",
    "compression": "^1.7.4",
    "cpeak": "2.9.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autocannon": "^8.0.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.7.2",
    "supertest": "^4.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.0.11"
  }
}
