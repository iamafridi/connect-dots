# This is an example .env file for the server. Copy it to `.env` and adjust the
# values for your machine. NEVER commit a real .env (it is gitignored).
#
#   cp .env.example .env

PORT='2080'
DOMAIN='http://localhost:2080'

# OPTIONAL: skip this and Google login will be disabled, everything else still works.
# Obtain credentials from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:2080/auth/google/callback
GOOGLE_CLIENT_ID='<generate-your-own>.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='<grab-from-google-cloud-console>'

# Secrets must each be at least 32 characters. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
COOKIE_KEY='<random-at-least-32-characters>'
TOKEN_SECRET='<random-at-least-32-characters>'

# OPTIONAL: when true, emails are logged to the console instead of sent via SES.
SKIP_EMAIL=true
AWS_REGION='us-east-1'
SES_FROM_EMAIL='ConnectDots <no-reply@connectdots.pro>'

# OPTIONAL: if left empty, link creation skips the malicious-URL check entirely.
# Grab a key from Google Cloud Console (Web Risk API — billing required,
# first 100k calls/month free): https://console.cloud.google.com/apis/credentials
WEB_RISK_API_KEY=''

REDIS_URL='redis://127.0.0.1:6379'
# Set to false to run entirely on Postgres (not recommended for production:
# the janitor and the views stream require Redis).
REDIS=true

# OPTIONAL: set to true ONLY when running behind a trusted reverse proxy
# (load balancer / Cloudflare) so the connection IP is taken from
# x-forwarded-for. It is client-spoofable, hence off by default.
TRUST_PROXY=false

# OPTIONAL: enable the /benchmark-style performance demo routes from the
# 1M RPS load-test suite. Off by default so production stays lean.
PERF_DEMO=false
# Bounds used by the demo /code-v4 route (records must be seeded up to this).
PERF_RECORD_LIMIT=10000000

# Postgres — these defaults work with a local Docker Postgres
DB_USER='postgres'
DB_HOST='localhost'
DB_DATABASE='connectdots'
DB_PASSWORD=''
DB_PORT='5432'